# Copy to `.env` in this folder and fill in what you need. Placeholders only.
# The model is public: no token is required to download or run it locally.
# Set HUGGINGFACE_API_KEY only for authenticated or faster downloads.

HUGGINGFACE_API_KEY=hf_replace_me

# Model and runtime
STT_MODEL_ID=ibm-granite/granite-speech-5.0-470m-turboctc
# "auto" places the model on the GPU when one is available, otherwise on CPU.
STT_DEVICE=auto

# Local server
STT_HOST=127.0.0.1
STT_PORT=8077