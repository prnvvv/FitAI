# Build context for backend/Dockerfile is the repository root.
# Allow-list approach: nothing enters the image unless it is listed here.
*

!requirements.txt
!backend/
!backend/alembic.ini
!backend/pyproject.toml
!backend/docker-entrypoint.sh
!backend/app/**
!backend/migrations/**

# Dockerfile.web (single service) also builds the frontend. BuildKit uses
# Dockerfile.web.dockerignore for it; these entries keep the build working if a
# builder falls back to this file instead.
!frontend/
!backend/requirements-web.txt
**/node_modules
**/dist

# Never ship secrets, local data, caches or tests, even inside allowed folders.
**/.env
**/.env.*
**/*.db
**/*.sqlite3
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
backend/chroma_data
backend/data
backend/uploads
backend/tests
backend/scripts
