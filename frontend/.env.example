# Frontend environment variables.
#
# Copy to `frontend/.env.local` (git-ignored) and adjust only if needed.
# Values here are the defaults baked into the code.

# FitAI backend API base. Leave unset in development: Vite proxies /api/v1 to
# the backend address configured in backend/.env.
# PRODUCTION (Vercel): REQUIRED. The full backend URL including the API prefix,
# no trailing slash, e.g. https://fitai-backend.onrender.com/api/v1
# It is baked in at build time; redeploy the frontend after changing it.
# VITE_API_BASE_URL=

# Supabase (required for sign-in). Both values are public by design; the anon
# key is protected by Row Level Security. Never put the service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Speech-to-text service (microphone dictation in the chat composer).
# The model runs inside the FitAI backend; the URL defaults to
# <VITE_API_BASE_URL>/stt. Only override this if you run a separate
# transcription service on another port.
# VITE_STT_URL=/api/v1/stt