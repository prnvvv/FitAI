# Frontend environment variables.
#
# Copy to `frontend/.env.local` (git-ignored) and adjust only if needed.
# Values here are the defaults baked into the code.

# FitAI backend. Leave unset in development: Vite proxies /api/v1 to the
# backend address configured in backend/.env.
# VITE_API_BASE_URL=/api/v1

# Supabase (required for sign-in).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Speech-to-text service (microphone dictation in the chat composer).
# A separate local process running IBM Granite Speech 5.0 TurboCTC; see
# `unit testing/speech to text/README.md` for how to start it.
# VITE_STT_URL=http://127.0.0.1:8077