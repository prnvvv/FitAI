{
  "name": "fitai",
  "private": true,
  "version": "1.0.0",
  "description": "FitAI monorepo - React frontend + FastAPI backend",
  "scripts": {
    "dev": "concurrently --names backend,frontend --prefix-colors cyan,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
    "dev:frontend": "cd frontend && npm run dev",
    "test:backend": "cd backend && python -m pytest -q",
    "test:frontend": "cd frontend && npm test",
    "type-check:frontend": "cd frontend && npm run type-check",
    "build:frontend": "cd frontend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
