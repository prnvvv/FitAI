# FitAI single-service image (one Render Web Service): FastAPI + built frontend.
#
# Build context: the repository root.
#   docker build -f Dockerfile.web -t fitai-web:latest \
#     --build-arg VITE_SUPABASE_URL=https://<project>.supabase.co \
#     --build-arg VITE_SUPABASE_ANON_KEY=<anon-key> .
#
# The Supabase URL and ANON key are public by design (they ship in the browser
# bundle). Never pass the service-role key or any other secret as a build arg.
# Runtime configuration comes from environment variables; migrations are NOT run
# at start-up (see docs/deployment.md).

# ---- frontend: build the static bundle ------------------------------------
FROM node:22-slim AS frontend
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
RUN npm run build

# ---- python: install only the single service's dependencies ----------------
FROM python:3.10-slim-bookworm AS builder
ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY backend/requirements-web.txt /tmp/requirements.txt
RUN pip install --upgrade pip \
    && pip install -r /tmp/requirements.txt \
    && pip check

# ---- runtime ----------------------------------------------------------------
FROM python:3.10-slim-bookworm AS runtime
RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin app
COPY --from=builder /opt/venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/home/app \
    ENVIRONMENT=production \
    FITAI_SERVICE=core \
    SERVE_DOCUMENTS_ROUTES=true \
    INGESTION_MODE=jobs \
    FRONTEND_DIST_DIR=/srv/fitai/frontend/dist \
    PORT=8000

WORKDIR /srv/fitai/backend
COPY backend/alembic.ini backend/pyproject.toml ./
COPY backend/migrations ./migrations
COPY backend/app ./app
COPY --from=frontend /build/frontend/dist /srv/fitai/frontend/dist
RUN chown -R app:app /srv/fitai

USER app
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/health' % os.environ.get('PORT','8000'), timeout=4)" || exit 1

# JSON (exec) form wrapping `sh -c` so Render's $PORT is expanded; `exec` makes
# uvicorn PID 1 for a graceful SIGTERM stop. Exactly one worker (memory-bound instance).
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port \"${PORT:-8000}\" --workers 1 --proxy-headers --forwarded-allow-ips \"*\" --timeout-graceful-shutdown \"${GRACEFUL_SHUTDOWN_SECONDS:-25}\""]
