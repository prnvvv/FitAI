# Backend environment variables.
# Copy this file to .env and fill in real values. Never commit `.env` — it
# contains secrets.
#
# Sections marked (Person 1) are owned by the backend/persistence developer;
# sections marked (Person 2) are owned by the AI-engine developer.

# ---- Application (Person 1) ----------------------------------------------
# development | production. In production the app REFUSES TO START unless the
# configuration is safe (PostgreSQL URL, explicit https CORS origins,
# SUPABASE_URL, GROQ_API_KEY, DEBUG=false, DOCUMENT_STORAGE_BACKEND=local).
ENVIRONMENT=development
DEBUG=true
APP_NAME=FitAI Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# CORS (comma-separated origins). Production: the exact deployed frontend
# origin(s), https only, no trailing slash, e.g. https://fitai.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional regex for additional origins such as Vercel preview deployments.
# CORS_ORIGIN_REGEX=https://fitai-.*-your-team\.vercel\.app

# ---- Database (Person 1) --------------------------------------------------
# Supabase provides a pooled connection string. Use the psycopg2 driver.
# postgres:// and postgresql:// URLs are accepted and use psycopg2. Hosted
# databases usually need TLS: append ?sslmode=require.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/fitai
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false

# ---- Supabase Auth (Person 1) ----------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
# Accept new-style keys (sb_publishable_... / sb_secret_...) or legacy JWT keys.
# The backend does not read SUPABASE_ANON_KEY; only the frontend needs it.
# SUPABASE_SERVICE_ROLE_KEY is server-side only (Documents service, Storage).
SUPABASE_ANON_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key

# Access-token verification.
# Newer Supabase projects sign with ES256/RS256 verified against a JWKS
# endpoint. Legacy symmetric (HS256) is only used when SUPABASE_JWT_SECRET is
# set; leave it empty otherwise.
SUPABASE_JWT_ALGORITHMS=ES256,RS256
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_CACHE_SECONDS=3600

# ---- Document storage (Person 1) -------------------------------------------
# unconfigured | local | supabase
DOCUMENT_STORAGE_BACKEND=unconfigured
MAX_UPLOAD_SIZE_MB=10
# Production: must be `local`, with UPLOAD_DIR on a persistent disk.
UPLOAD_DIR=./uploads

# ---- AI / LLM (Person 2) ---------------------------------------------------
# GROQ_MODEL is the primary chat + extraction model. Reasoning models such as
# openai/gpt-oss-* only accept temperature=1/top_p=1, need a completion budget
# that covers their reasoning tokens, and reject tool calling; the client
# handles all three automatically (see app/llm/client.py).
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Dedicated extraction LLM (separate key + model) for automatic memory
# intelligence: structured memory/activity extraction only. It proposes
# candidate facts and never answers the user. Its credentials are independent of
# GROQ_API_KEY and there is NO fallback: leaving the key blank disables
# extraction entirely while normal chat keeps working unchanged.
# Never commit a real key.
GROQ_EXTRACTION_API_KEY=
GROQ_EXTRACTION_MODEL=openai/gpt-oss-120b
# Master switch for the extraction step in the chat flow.
AGENT_ACTIVITY_EXTRACTION=true
# Hard cap (seconds) on one extraction call. Extraction runs inline before the
# reply, so a slow provider must not hold the response open; on timeout nothing
# is saved and the next message retries.
EXTRACTION_TIMEOUT_S=20.0

# ---- Image text extraction: vision / OCR (Person 2) -------------------------
# Providers are tried left to right and the first one that returns text wins.
#   groq     - a vision-capable Groq model; needs GROQ_API_KEY
#   rapidocr - local OCR (rapidocr-onnxruntime); no key, no system binary
# Leave VISION_MODEL empty to auto-detect a vision-capable model from the
# Groq account's model list. An image with no readable text is indexed as a
# valid, empty result rather than a failure.
VISION_PROVIDER_ORDER=groq,rapidocr
VISION_MODEL=
# Longest image edge (px) used for OCR after downscaling.
OCR_MAX_SIDE_PX=1600

# ---- RAG / ChromaDB (Person 2) ---------------------------------------------
# Relative paths are resolved against backend/. Production: an absolute path on
# a persistent disk (the Docker image defaults to /var/data/chroma).
CHROMADB_PERSIST_DIR=./chroma_data
CHROMADB_COLLECTION_NAME=fitai_knowledge
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Disable ChromaDB telemetry; must be set before any chromadb import.
ANONYMIZED_TELEMETRY=False

# ---- Agent capability flags (additive, default OFF) -------------------------
# Set to true only after verifying each layer. With flags off, behavior is unchanged.
AGENT_WEB_TOOLS=false
AGENT_LOCATION_TOOLS=false
AGENT_MULTI_AGENT=false

# ---- Web search provider chain (comma-separated, tried in order) ------------
# Supported: tavily, brave, serper, ddgs. If no key is set for a keyed provider,
# it is skipped. Default is "ddgs" (no key required).
SEARCH_PROVIDERS=ddgs
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# ---- Web fetch / research budgets -------------------------------------------
WEB_FETCH_TIMEOUT_SECONDS=12
WEB_MAX_REDIRECTS=3
WEB_MAX_CONTENT_BYTES=2000000
WEB_MAX_TOOL_CALLS_PER_TURN=6
WEB_CACHE_TTL_SECONDS=300
WEB_USER_RATE_LIMIT_PER_MINUTE=30

# ---- Multi-agent model roles (defaults to GROQ_MODEL if blank) --------------
ROUTER_MODEL=
RESEARCH_MODEL=
SYNTH_MODEL=

# ---- Guardrails (security) --------------------------------------------------
GUARDRAILS_ENABLED=true
# Prompt-injection guard model. A CLASSIFIER, not a chat model: it takes a
# single user message and returns the probability that it is a jailbreak attempt
# (0 = safe, 1 = unsafe). It screens user messages and retrieved documents and
# never answers the user. Leave the key empty to reuse GROQ_API_KEY; set
# PROMPT_GUARD_ENABLED=false to keep only the deterministic rules. Any error or
# timeout fails open, so a guard outage can never break chat.
PROMPT_GUARD_ENABLED=true
PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
PROMPT_GUARD_API_KEY=
PROMPT_GUARD_THRESHOLD=0.5   # score at/above which text is treated as an injection
PROMPT_GUARD_TIMEOUT_S=2.0   # per-call timeout; on error the guard fails open
GUARDRAILS_MODE=enforce  # enforce | monitor | disabled
GUARD_MODEL=  # defaults to GROQ_MODEL if blank
GUARD_CANARY=  # random token for output guard; generate one for production
GUARD_CLASSIFIER_ENABLED=true  # LLM intent classifier decision layer; false = deterministic-only
GUARD_TIMEOUT_S=1.5  # per-call timeout for the classifier's single Groq completion
GUARD_MAX_TOKENS=200  # cap on the classifier completion; its JSON verdict is tiny
GUARD_CONF_THRESHOLD=0.6  # below this confidence, fall back to deterministic allow

# ---- Cross-chat continuity (memory + past-chat recall) ----------------------
CONTINUITY_ENABLED=true  # index memories + conversation summaries; false = off
SUMMARY_MODEL=  # model for conversation summaries; defaults to GROQ_MODEL if blank
PAST_CHAT_RECALL_DEFAULT=true  # default for the per-user "reference past chats" toggle
MEMORY_RECALL_DEFAULT=true  # default for the per-user "use memory" toggle
CONTINUITY_RECALL_K=4  # recalled items per layer (memories / past chats)

# ---- Location / places / weather providers ----------------------------------
# Geocoding: nominatim (keyless, default), google, mapbox
GEOCODING_PROVIDER=nominatim
GOOGLE_GEOCODING_API_KEY=
MAPBOX_API_KEY=

# Places: overpass (keyless, default), google, foursquare
PLACES_PROVIDER=overpass
GOOGLE_PLACES_API_KEY=
FOURSQUARE_API_KEY=

# Weather: open-meteo (keyless, default)
WEATHER_PROVIDER=open-meteo

# ---- Speech input ----------------------------------------------------------
# Dictation is browser-native (Web Speech API) and needs NO backend setting.
# See frontend/SPEECH_TO_TEXT.md.

# ---- Container / Render (see docs/DEPLOYMENT_GUIDE.md) -----------------------
# PORT is injected by Render and honoured as an alias of BACKEND_PORT.
# PORT=10000
# Apply Alembic migrations (upgrade only) before the server starts.
# RUN_MIGRATIONS=true
# Seconds uvicorn waits for in-flight requests on SIGTERM.
# GRACEFUL_SHUTDOWN_SECONDS=25

# =============================================================================
# SPLIT-SERVICE DEPLOYMENT (Render: fitai-core, fitai-documents)
# =============================================================================
# Placeholders only. Real values go in the Render dashboard, never in Git.
# Which variables each service needs is validated at start-up in production
# (app/core/config.py: Settings.production_problems); a missing one aborts boot
# with an explicit message. See DEPLOYMENT_GUIDE.md for the full matrix.

# Which deployable service this process is: core | documents.
FITAI_SERVICE=core

# ---- Core only -------------------------------------------------------------
# Production Core does not serve documents (a separate service does).
# Defaults to true so a single local process keeps serving everything.
SERVE_DOCUMENTS_ROUTES=true

# ---- Vector store + embeddings (Core and Documents) -------------------------
# chroma (local development default) | pgvector (Supabase PostgreSQL, production)
VECTOR_STORE_BACKEND=chroma
# local = Chroma's bundled ONNX MiniLM (dev). remote = HTTP; REQUIRED with pgvector,
# because a local embedding model does not fit a 512 MB instance.
EMBEDDING_PROVIDER=local
# Remote embedding endpoint. Production: Qwen3-Embedding-0.6B (1024-d) through the Hugging Face
# router (DeepInfra), OpenAI format, authenticated with a Hugging Face token. No default.
# (needs Inference Providers credit on the Hugging Face account)
EMBEDDING_API_URL=https://router.huggingface.co/deepinfra/v1/openai/embeddings
EMBEDDING_API_KEY=
# hf (POST {"inputs": [...]} -> [[...]]) | openai (POST {"input": [...], "model": ...})
EMBEDDING_API_FORMAT=openai
EMBEDDING_REMOTE_MODEL=Qwen/Qwen3-Embedding-0.6B
# Every vector must have exactly this many dimensions: 1024 for Qwen3-Embedding-0.6B
# (must equal the vector_chunks column; migration 0006), 384 for the local MiniLM default.
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_S=30

# ---- Documents service ------------------------------------------------------
# DOCUMENT_STORAGE_BACKEND=supabase uses a PRIVATE Supabase Storage bucket and the
# service-role key (server-side only; never put it in frontend configuration).
SUPABASE_STORAGE_BUCKET=fitai-documents
SUPABASE_STORAGE_TIMEOUT_S=30
# inline = in-process BackgroundTask (development). jobs = durable, checkpointed
# PostgreSQL-backed jobs that survive restarts/spin-down (production).
INGESTION_MODE=inline
INGESTION_WORKER_ENABLED=true
INGESTION_PAGES_PER_BATCH=5
INGESTION_POLL_SECONDS=5
INGESTION_LEASE_SECONDS=120
INGESTION_MAX_ATTEMPTS=3

# ---- Optional reranking: Hugging Face sentence similarity (hf-inference) ----
# Reorders chunks the vector store already retrieved; never creates or stores embeddings.
# Needs a Hugging Face token with Inference Providers access. Off by default; on any failure
# retrieval silently keeps the vector-similarity order. HUGGINGFACE_API_KEY is accepted as an alias.
HF_TOKEN=
HF_RERANKING_ENABLED=false
HF_RERANKING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Max candidates sent per query (one request), request timeout, and pause after a failure.
HF_RERANKING_CANDIDATES=12
HF_RERANKING_TIMEOUT_S=8
HF_RERANKING_COOLDOWN_S=60
