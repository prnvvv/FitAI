# Backend environment variables.
# Copy this file to .env and fill in real values. Never commit `.env` — it
# contains secrets.
#
# Sections marked (Person 1) are owned by the backend/persistence developer;
# sections marked (Person 2) are owned by the AI-engine developer.

# ---- Application (Person 1) ----------------------------------------------
ENVIRONMENT=development
DEBUG=true
APP_NAME=FitAI Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database (Person 1) --------------------------------------------------
# Supabase provides a pooled connection string. Use the psycopg2 driver.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/fitai
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false

# ---- Supabase Auth (Person 1) ----------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Access-token verification.
# Newer Supabase projects sign with ES256/RS256 verified against a JWKS
# endpoint. Legacy symmetric (HS256) is only used when SUPABASE_JWT_SECRET is
# set; leave it empty otherwise.
SUPABASE_JWT_ALGORITHMS=ES256,RS256
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_CACHE_SECONDS=3600

# ---- Document storage (Person 1) -------------------------------------------
# unconfigured | local | supabase
DOCUMENT_STORAGE_BACKEND=unconfigured
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# ---- AI / LLM (Person 2) ---------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
# Vision model used to read uploaded images. Leave empty to auto-detect a
# vision-capable model from the account's model list. When the account exposes
# none, image ingestion fails with "Image reading isn't available right now."
GROQ_VISION_MODEL=

# ---- RAG / ChromaDB (Person 2) ---------------------------------------------
CHROMADB_PERSIST_DIR=./chroma_data
CHROMADB_COLLECTION_NAME=fitai_knowledge
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Disable ChromaDB telemetry; must be set before any chromadb import.
ANONYMIZED_TELEMETRY=False

# ---- Agent capability flags (additive, default OFF) -------------------------
# Set to true only after verifying each layer. With flags off, behavior is unchanged.
AGENT_WEB_TOOLS=false
AGENT_LOCATION_TOOLS=false
AGENT_MULTI_AGENT=false

# ---- Web search provider chain (comma-separated, tried in order) ------------
# Supported: tavily, brave, serper, ddgs. If no key is set for a keyed provider,
# it is skipped. Default is "ddgs" (no key required).
SEARCH_PROVIDERS=ddgs
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# ---- Web fetch / research budgets -------------------------------------------
WEB_FETCH_TIMEOUT_SECONDS=12
WEB_MAX_REDIRECTS=3
WEB_MAX_CONTENT_BYTES=2000000
WEB_MAX_TOOL_CALLS_PER_TURN=6
WEB_CACHE_TTL_SECONDS=300
WEB_USER_RATE_LIMIT_PER_MINUTE=30

# ---- Multi-agent model roles (defaults to GROQ_MODEL if blank) --------------
ROUTER_MODEL=
RESEARCH_MODEL=
SYNTH_MODEL=

# ---- Location / places / weather providers ----------------------------------
# Geocoding: nominatim (keyless, default), google, mapbox
GEOCODING_PROVIDER=nominatim
GOOGLE_GEOCODING_API_KEY=
MAPBOX_API_KEY=

# Places: overpass (keyless, default), google, foursquare
PLACES_PROVIDER=overpass
GOOGLE_PLACES_API_KEY=
FOURSQUARE_API_KEY=

# Weather: open-meteo (keyless, default)
WEATHER_PROVIDER=open-meteo
