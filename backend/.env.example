# Backend environment variables.
# Copy this file to .env and fill in real values. Never commit `.env` — it
# contains secrets.
#
# Sections marked (Person 1) are owned by the backend/persistence developer;
# sections marked (Person 2) are owned by the AI-engine developer.

# ---- Application (Person 1) ----------------------------------------------
ENVIRONMENT=development
DEBUG=true
APP_NAME=FitAI Backend
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database (Person 1) --------------------------------------------------
# Supabase provides a pooled connection string. Use the psycopg2 driver.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/fitai
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false

# ---- Supabase Auth (Person 1) ----------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Access-token verification.
# Newer Supabase projects sign with ES256/RS256 verified against a JWKS
# endpoint. Legacy symmetric (HS256) is only used when SUPABASE_JWT_SECRET is
# set; leave it empty otherwise.
SUPABASE_JWT_ALGORITHMS=ES256,RS256
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_CACHE_SECONDS=3600

# ---- Document storage (Person 1) -------------------------------------------
# unconfigured | local | supabase
DOCUMENT_STORAGE_BACKEND=unconfigured
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# ---- AI / LLM (Person 2) ---------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# ---- RAG / ChromaDB (Person 2) ---------------------------------------------
CHROMADB_PERSIST_DIR=./chroma_data
CHROMADB_COLLECTION_NAME=fitai_knowledge
EMBEDDING_MODEL=all-MiniLM-L6-v2