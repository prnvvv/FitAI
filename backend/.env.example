# Backend environment variables.
# Copy this file to .env and fill in real values. Never commit .env.

# Application
ENVIRONMENT=development
DEBUG=true
APP_NAME=FitAI Backend
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL (Supabase provides a connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fitai

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
JWT_ALGORITHM=HS256
JWT_SECRET=your-jwt-secret-used-for-local-verification

# AI / LLM
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama3-70b-8192

# ChromaDB
CHROMADB_PERSIST_DIR=./chroma_data
CHROMADB_COLLECTION_NAME=fitai_knowledge

# Embeddings (ChromaDB default embedding function uses all-MiniLM-L6-v2)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# File uploads
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads
